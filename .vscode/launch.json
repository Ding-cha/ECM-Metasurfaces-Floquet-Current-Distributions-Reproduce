{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Plot symmetric cross current",
      "type": "python",
      "request": "launch",
      "module": "symmetric_cross_mts.plot_current",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      }
    },
    {
      "name": "Run restored ECM candidate",
      "type": "python",
      "request": "launch",
      "module": "symmetric_cross_mts.run_ecm",
      "args": ["--anchors"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      }
    },
    {
      "name": "Run Fig. 15 calibrated ECM",
      "type": "python",
      "request": "launch",
      "module": "symmetric_cross_mts.run_ecm",
      "args": ["--mode", "calibrated", "--anchors"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      }
    },
    {
      "name": "Run raw analytical ECM",
      "type": "python",
      "request": "launch",
      "module": "symmetric_cross_mts.run_ecm",
      "args": ["--mode", "raw"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      }
    },
    {
      "name": "Diagnose ECM mismatch",
      "type": "python",
      "request": "launch",
      "module": "symmetric_cross_mts.diagnose_ecm",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}\\src"
      }
    }
  ]
}

{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install editable package",
      "type": "shell",
      "command": "D:\\anaconda3\\python.exe -m pip install -e .",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Plot current",
      "type": "shell",
      "command": "$env:PYTHONPATH='${workspaceFolder}\\src'; D:\\anaconda3\\python.exe -m symmetric_cross_mts.plot_current",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run restored ECM candidate",
      "type": "shell",
      "command": "$env:PYTHONPATH='${workspaceFolder}\\src'; D:\\anaconda3\\python.exe -m symmetric_cross_mts.run_ecm --anchors",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run Fig. 15 calibrated ECM",
      "type": "shell",
      "command": "$env:PYTHONPATH='${workspaceFolder}\\src'; D:\\anaconda3\\python.exe -m symmetric_cross_mts.run_ecm --mode calibrated --anchors",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run raw analytical ECM",
      "type": "shell",
      "command": "$env:PYTHONPATH='${workspaceFolder}\\src'; D:\\anaconda3\\python.exe -m symmetric_cross_mts.run_ecm --mode raw",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Diagnose ECM mismatch",
      "type": "shell",
      "command": "$env:PYTHONPATH='${workspaceFolder}\\src'; D:\\anaconda3\\python.exe -m symmetric_cross_mts.diagnose_ecm",
      "group": "test",
      "problemMatcher": []
